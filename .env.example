# Required application login. Use a unique server-only passphrase (20+ chars).
FRAGMENTS_AUTH_PASSPHRASE=

# Keep true behind HTTPS. Set false only for plain-HTTP local development.
FRAGMENTS_COOKIE_SECURE=true

# Optional session lifetime in seconds (default: 604800; range: 300-2592000).
FRAGMENTS_SESSION_MAX_AGE=604800

# Server-side transcription only. Never expose this value in browser code.
OPENAI_API_KEY=

# The current default. A later provider can be added without changing capture UX.
TRANSCRIPTION_PROVIDER=openai
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe

# Optional compact vocabulary hint from the private control service.
# Set the same long random value on the control service and Fragments service.
TRANSCRIPTION_CONTEXT_URL=https://minutes.hope-johnstone.com/internal/transcription-context
FRAGMENTS_CONTEXT_SECRET=

# Optional immediate low-risk actions. Set the same long random value on the
# private control service; this value is never sent to the browser.
HARVESTER_ACTION_URL=https://minutes.hope-johnstone.com
FRAGMENTS_HARVESTER_SECRET=
